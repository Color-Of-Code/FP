{
  "name": "fp-tools",
  "private": true,
  "type": "module",
  "description": "Dev tooling for the FP repository",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "lint:md": "markdownlint-cli2 '../**/*.md' '!../node_modules/**' '!./node_modules/**' '!./vscode-sysml/node_modules/**' '!./vscode-sysml/dist/**'",
    "lint:langs": "node --experimental-strip-types check-lang-order.ts",
    "fmt:md": "prettier --write '../**/*.md'",
    "check:md": "prettier --check '../**/*.md'",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "typecheck": "tsc --noEmit",
    "langium:gen": "langium generate"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^28.0.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "eslint-plugin-functional": "^9.0.5",
    "eslint-plugin-lodash": "^8.1.0",
    "jiti": "^2.7.0",
    "langium": "^4.4.2",
    "langium-cli": "^4.4.1",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "d3": "^7.9.2",
    "elkjs": "^0.11.1",
    "fp-ts": "^2.16.11",
    "jsdom": "^29.1.1",
    "lodash-es": "^4.17.21",
    "xmlbuilder2": "^4.0.3"
  }
}
