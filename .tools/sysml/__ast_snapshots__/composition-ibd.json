{
  "packages": [
    {
      "name": "CompositionSignature",
      "portDefs": [],
      "partDefs": [
        {
          "kind": "partDef",
          "name": "compose",
          "parts": [
            {
              "kind": "part",
              "id": "x",
              "type": "a — supplied when h is called",
              "ports": [],
              "role": "value",
              "tooltip": "The argument of h: supplied when h is called, not when compose builds it."
            },
            {
              "kind": "part",
              "id": "run_f",
              "type": "f x",
              "ports": [
                {
                  "kind": "port",
                  "id": "f",
                  "type": "a ⟶ b",
                  "direction": "in"
                },
                {
                  "kind": "port",
                  "id": "a",
                  "type": "a",
                  "direction": "in"
                },
                {
                  "kind": "port",
                  "id": "_",
                  "type": "b",
                  "direction": "out"
                }
              ],
              "role": "function",
              "tooltip": "Apply f to the argument: the first step of h."
            },
            {
              "kind": "part",
              "id": "run_g",
              "type": "g b",
              "ports": [
                {
                  "kind": "port",
                  "id": "g",
                  "type": "b ⟶ c",
                  "direction": "in"
                },
                {
                  "kind": "port",
                  "id": "b",
                  "type": "b",
                  "direction": "in"
                },
                {
                  "kind": "port",
                  "id": "_",
                  "type": "c",
                  "direction": "out"
                }
              ],
              "role": "function",
              "tooltip": "Apply g to the result of f: the second step of h. This is the only place where f's output meets g's input."
            },
            {
              "kind": "part",
              "id": "wrap",
              "type": "λx → c",
              "ports": [
                {
                  "kind": "port",
                  "id": "_",
                  "type": "c",
                  "direction": "in"
                },
                {
                  "kind": "port",
                  "id": "_",
                  "type": "a ⟶ c",
                  "direction": "out"
                }
              ],
              "role": "function",
              "tooltip": "Abstract over x again: the whole body becomes the function h that compose returns."
            }
          ],
          "ports": [
            {
              "kind": "port",
              "id": "g",
              "type": "b ⟶ c",
              "direction": "in",
              "tooltip": "g : b ⟶ c — runs second; its input type must equal f's output type"
            },
            {
              "kind": "port",
              "id": "f",
              "type": "a ⟶ b",
              "direction": "in",
              "tooltip": "f : a ⟶ b — runs first"
            },
            {
              "kind": "port",
              "id": "h",
              "type": "a ⟶ c",
              "direction": "out",
              "tooltip": "h = g ∘ f : a ⟶ c — a new function; nothing has been applied yet"
            }
          ],
          "connections": [
            {
              "kind": "connection",
              "from": "f",
              "to": "run_f.f",
              "label": "first"
            },
            {
              "kind": "connection",
              "from": "x",
              "to": "run_f.a",
              "label": "argument"
            },
            {
              "kind": "connection",
              "from": "run_f._",
              "to": "run_g.b",
              "label": "b (internal only)"
            },
            {
              "kind": "connection",
              "from": "g",
              "to": "run_g.g",
              "label": "second"
            },
            {
              "kind": "connection",
              "from": "run_g._",
              "to": "wrap._",
              "label": "result"
            },
            {
              "kind": "connection",
              "from": "wrap._",
              "to": "h"
            }
          ],
          "notes": [],
          "shows": {
            "x": "value",
            "run_f": "function",
            "run_g": "function",
            "wrap": "function"
          },
          "tooltips": {
            "x": "The argument of h: supplied when h is called, not when compose builds it.",
            "run_f": "Apply f to the argument: the first step of h.",
            "run_g": "Apply g to the result of f: the second step of h. This is the only place where f's output meets g's input.",
            "wrap": "Abstract over x again: the whole body becomes the function h that compose returns."
          }
        }
      ],
      "actionDefs": [],
      "activityDefs": [],
      "views": [
        {
          "id": "diagram",
          "packageName": "CompositionSignature",
          "viewType": "FpIbdView",
          "expose": "compose",
