              "type": "transaction log",
              "ports": [],
              "role": "value",
              "tooltip": "The transaction log: TVar reads and tentative writes are recorded here, not applied. One log is shared by both steps."
            },
            {
              "kind": "part",
              "id": "run_ma",
              "type": "run ma",
              "ports": [
                {
                  "kind": "port",
                  "id": "m",
                  "type": "STM a",
                  "direction": "in"
                },
                {
                  "kind": "port",
                  "id": "log",
                  "type": "log",
                  "direction": "in"
                },
                {
                  "kind": "port",
                  "id": "_",
                  "type": "a",
                  "direction": "out"
                }
              ],
              "role": "function",
              "tooltip": "Run the first action against the log, producing a."
            },
            {
              "kind": "part",
              "id": "call",
              "type": "f a",
              "ports": [
                {
                  "kind": "port",
                  "id": "f",
                  "type": "a ⟶ STM b",
                  "direction": "in"
                },
                {
                  "kind": "port",
                  "id": "a",
                  "type": "a",
                  "direction": "in"
                },
                {
                  "kind": "port",
                  "id": "_",
                  "type": "STM b",
                  "direction": "out"
                }
              ],
              "role": "function",
              "tooltip": "Apply f to the result: yields the next atomic action, not yet run."
            },
            {
              "kind": "part",
              "id": "run_next",
              "type": "run (f a)",
              "ports": [
                {
                  "kind": "port",
                  "id": "m",
                  "type": "STM b",
                  "direction": "in"
                },
                {
                  "kind": "port",
                  "id": "log",
                  "type": "log",
                  "direction": "in"
                },
                {
                  "kind": "port",
                  "id": "_",
                  "type": "b",
                  "direction": "out"
                }
              ],
              "role": "function",
              "tooltip": "The STM-specific join: run the action f built against the SAME log, so both steps form one atomic unit."
            },
            {
              "kind": "part",
              "id": "commit",
              "type": "commit or retry",
              "ports": [
                {
                  "kind": "port",
                  "id": "_",
                  "type": "b",
                  "direction": "in"
                },
                {
                  "kind": "port",
                  "id": "_",
                  "type": "b",
                  "direction": "out"
                }
              ],
              "role": "function",
              "tooltip": "atomically: validate the log against the current TVar values. If nothing conflicts, publish all writes at once; otherwise (or on retry) discard the log and start over."
            },
            {
              "kind": "part",
              "id": "wrap",
              "type": "atomic action",
              "ports": [
                {
                  "kind": "port",
                  "id": "_",
                  "type": "b",
                  "direction": "in"
                },
                {
                  "kind": "port",
                  "id": "_",
                  "type": "STM b",
                  "direction": "out"
                }
              ],
              "role": "function",
              "tooltip": "Package the whole script as one atomic action, to be run by atomically."
            }
          ],
          "ports": [
            {
              "kind": "port",
              "id": "ma",
              "type": "STM a",
              "direction": "in",
              "tooltip": "STM a — an atomic action on TVars (transactional variables). Not yet committed."
            },
            {
              "kind": "port",
              "id": "f",
              "type": "a ⟶ STM b",
              "direction": "in",
